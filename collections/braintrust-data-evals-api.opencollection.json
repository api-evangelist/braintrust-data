{
  "opencollection": "1.0.0",
  "info": {
    "name": "Braintrust REST ACL Evals API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Evals",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Launch an eval",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.braintrust.dev/v1/eval",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Launch an evaluation. This is the API-equivalent of the Eval function in the SDK; it runs a task function over a dataset and applies scorers."
        }
      ]
    }
  ],
  "bundled": true
}