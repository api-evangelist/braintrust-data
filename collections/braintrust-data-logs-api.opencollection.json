{
  "opencollection": "1.0.0",
  "info": {
    "name": "Braintrust REST ACL Logs API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Insert project logs events",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.braintrust.dev/v1/project_logs/:project_id/insert",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "Project id, the unique identifier of the project."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Insert a set of trace span / log events into a project's logs."
        },
        {
          "info": {
            "name": "Fetch project logs (GET form)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.braintrust.dev/v1/project_logs/:project_id/fetch",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "Project id, the unique identifier of the project."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limit the number of objects to return."
              }
            ]
          },
          "docs": "Fetch project logs (GET form)"
        },
        {
          "info": {
            "name": "Fetch project logs (POST form)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.braintrust.dev/v1/project_logs/:project_id/fetch",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "Project id, the unique identifier of the project."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Fetch project logs (POST form)"
        },
        {
          "info": {
            "name": "Feedback for project logs events",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.braintrust.dev/v1/project_logs/:project_id/feedback",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "Project id, the unique identifier of the project."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Feedback for project logs events"
        }
      ]
    }
  ],
  "bundled": true
}