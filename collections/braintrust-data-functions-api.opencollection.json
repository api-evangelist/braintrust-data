{
  "opencollection": "1.0.0",
  "info": {
    "name": "Braintrust REST ACL Functions API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Functions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List functions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.braintrust.dev/v1/function",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limit the number of objects to return."
              },
              {
                "name": "project_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "function_name",
                "value": "",
                "type": "query"
              },
              {
                "name": "slug",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List functions"
        },
        {
          "info": {
            "name": "Create function",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.braintrust.dev/v1/function",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create function"
        },
        {
          "info": {
            "name": "Create or replace function",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.braintrust.dev/v1/function",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create or replace function"
        },
        {
          "info": {
            "name": "Get function",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.braintrust.dev/v1/function/:function_id",
            "params": [
              {
                "name": "function_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get function"
        },
        {
          "info": {
            "name": "Partially update function",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.braintrust.dev/v1/function/:function_id",
            "params": [
              {
                "name": "function_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Partially update function"
        },
        {
          "info": {
            "name": "Delete function",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.braintrust.dev/v1/function/:function_id",
            "params": [
              {
                "name": "function_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete function"
        },
        {
          "info": {
            "name": "Invoke function",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.braintrust.dev/v1/function/:function_id/invoke",
            "params": [
              {
                "name": "function_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Invoke a function (a prompt, code, or LLM scorer) server-side with the given input. Optionally stream the result and write a trace span to a parent object."
        }
      ]
    }
  ],
  "bundled": true
}